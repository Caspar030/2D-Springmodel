% Reduce space before and after equations
\AtBeginDocument{
	\setlength{\abovedisplayskip}{0.75\abovedisplayskip}
	\setlength{\belowdisplayskip}{0.75\belowdisplayskip}
	\setlength{\abovedisplayshortskip}{0.75\abovedisplayshortskip}
	\setlength{\belowdisplayshortskip}{0.75\belowdisplayshortskip}
}

\renewcommand{\epsilon}{\varepsilon}


% Theorem etc. structure
\newtheoremstyle{newStyle}
{}                % Space above
{}                % Space below
{\itshape}        % Theorem body font % (default is "\upshape")
{}                % Indent amount
{\bfseries}       % Theorem head font % (default is \mdseries)
{}                % Punctuation after theorem head % default: no punctuation
{2ex}           	  % Space after theorem head
{}                % Theorem head spec
\theoremstyle{newStyle}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{corollary}[definition]{Corollary}
\newtheorem{lemma}[definition]{Lemma}
\newtheorem{condition}[definition]{Condition}
\newtheorem{theorem}[definition]{Theorem}
\newtheorem{remark}[definition]{Remark}
\newtheorem{proposition}[definition]{Proposition}
\newtheorem{notation}[definition]{Notation}
\newtheorem{fact}[definition]{Fact}
\newtheorem{example}[definition]{Example}
%\newtheorem{myExample}[definition]{Example}

