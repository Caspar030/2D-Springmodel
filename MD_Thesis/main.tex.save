	bookmarksnumbered = true, % enumerate the bookmarks
	plainpages = false, 
	hypertexnames = false,
	linkcolor= DarkBlueCustom,
	urlcolor=DarkBlueCustom,
	citecolor=DarkBlueCustom
]{hyperref}
