%%% Colors
\usepackage[dvipsnames]{xcolor}
\definecolor{color1}{HTML}{FF2600} % red
\definecolor{color2}{HTML}{008F00} % green
\definecolor{color3}{HTML}{0096FF} % blue
\definecolor{color4}{HTML}{9437FF} % violet
\definecolor{DarkBlueCustom}{RGB}{0,0,120}   % darker than NavyBlue


%%% Lists
\usepackage{enumitem}
% Unnumbered
\setlist[itemize]{topsep=0.5\topsep, itemsep=0.5\itemsep} %, parsep=0.5\parsep, partopsep=0.5\partopsep}
\newlist{itemizeProof}{itemize}{3}
\setlist[itemizeProof, 1]{leftmargin=*, label={\textbullet}} %,parsep=0.5\parsep, partopsep=0.5\partopsep}
\setlist[itemizeProof, 2]{leftmargin=*, label={--}} %,parsep=0.5\parsep, partopsep=0.5\partopsep}
\setlist[itemizeProof, 3]{leftmargin=*, label={*}} %,parsep=0.5\parsep, partopsep=0.5\partopsep}

% Numbered
\setlist[enumerate,1]{label=\textbf{(\alph*)}}
\newlist{enumerateRoman}{enumerate}{1}
\setlist[enumerateRoman, 1]{label=\textbf{(\roman*)}}

\newlist{enumerateProof}{enumerate}{1}	
\setlist[enumerateProof,1]{wide, label=\textbf{(\alph*)}} %, parsep=0.5\parsep, partopsep=0.5\partopsep}
\newlist{enumerateRomanProof}{enumerate}{1}
\setlist[enumerateRomanProof,1]{leftmargin=*, label=\textbf{(\roman*)}} % partopsep=0.5\partopsep

% TFAE
\newcommand{\RNum}[1]{\uppercase\expandafter{\romannumeral #1\relax}}
