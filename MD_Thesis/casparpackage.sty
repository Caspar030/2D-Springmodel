% Definitions of theorems and special equal signs.
\newtheoremstyle{myStyle}
{}                % Space above
{}                % Space below
{\upshape}        % Theorem body font % (default is "\upshape")
{}                % Indent amount
{\bfseries}       % Theorem head font % (default is \mdseries)
{}               % Punctuation after theorem head % default: no punctuation
{.25cm}               % Space after theorem head
{}                % Theorem head spec
\theoremstyle{myStyle}
\newtheorem*{zuzeigen2}{Zu Zeigen:}
\newtheorem*{claimm2}{Claim:}

% Hand made theorem
\def\claimgerman{\noindent{\textbf{Zu zeigen:}}\ }
\def\endclaimgerman{\par}
\newenvironment{zuzeigen}{\claimgerman}{\endclaimgerman}

\def\claimenglish{\noindent{\textbf{Claim:}}\ }
\def\endclaimenglish{\par}
\newenvironment{claimm}{\claimenglish}{\endclaimenglish}

\newenvironment{claimproof}[2][\unskip]{%
	\par
	\noindent\textbf{Claim #1:} #2 \\
	\noindent\textit{Proof of claim.}%
}{%
	\unskip\nobreak\hfill\mbox{\qedsymbol\ {\scriptsize Claim.}}\par}


